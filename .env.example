# Copy to .env (never commit .env). Everything is optional: with no keys MatchGist runs on offline templates.

# Language agents: Azure OpenAI in Microsoft Foundry, API-key auth
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_DIGEST=
AZURE_OPENAI_API_VERSION=2024-10-21

# ...or a Foundry project with Entra ID (az login / managed identity) instead of a key
AZURE_AI_PROJECT_ENDPOINT=

# ...or any OpenAI-compatible endpoint, e.g. a free tier (no Azure needed). Groq example:
#   MATCHGIST_LLM_BASE_URL=https://api.groq.com/openai/v1
#   MATCHGIST_LLM_MODEL=<a model id from the provider's model list>
MATCHGIST_LLM_BASE_URL=
MATCHGIST_LLM_API_KEY=
MATCHGIST_LLM_MODEL=
# Caps on model calls (0 = none). Over the cap, agents use the templates at once. A match makes ~95 calls.
MATCHGIST_LLM_CALLS_PER_MINUTE=0
MATCHGIST_LLM_CALLS_PER_DAY=0

# Voice notes: Azure AI Speech (text to speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Stretch: real SMS via Azure Communication Services (not wired yet)
ACS_CONNECTION_STRING=

SIM_SEED=42
SIM_SPEED=10
MATCHGIST_OFFLINE=
MATCHGIST_LLM_TIMEOUT=8
